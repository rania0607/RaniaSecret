
{
  "version": 2,
  "builds": [
    {
      "src": "frontend/static/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/static/**",
      "use": "@vercel/static"
    },
    {
      "src": "backend/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "frontend/**",
          "backend/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/sounds/(.*)",
      "dest": "/public/static/sounds/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/app.py"
    }
  ]
}
